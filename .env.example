# Server
NODE_ENV=development
PORT=3000
API_PREFIX=/api/v1

# Database
DATABASE_URL=postgresql://fakespy:fakespy_secret@localhost:5432/fakespy_db

# Redis
REDIS_URL=redis://localhost:6379

# JWT
# Generate each with: openssl rand -hex 32  (must be different, >= 32 chars)
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Stripe
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
STRIPE_PRICE_PRO=price_pro_id
STRIPE_PRICE_AGENCY=price_agency_id

# OpenAI
OPENAI_API_KEY=sk-your-openai-api-key

# Frontend
FRONTEND_URL=http://localhost:5173

# Email (future integration)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@fakespy.ai

# Encryption key for stored API keys (32 bytes hex)
# 32 bytes hex (64 chars). Generate with: openssl rand -hex 32
ENCRYPTION_KEY=

# Sentry (optional)
SENTRY_DSN=

# Logging
LOG_LEVEL=debug

# Seed endpoint guard (GET/POST /seed?secret=...). Leave empty to disable the endpoint.
# Use a random string — NOT the JWT secret.
SEED_SECRET=
# Optional: fixed admin password for the seed endpoint. If unset, a random one is
# generated and returned once in the /seed response.
SEED_ADMIN_PASSWORD=
